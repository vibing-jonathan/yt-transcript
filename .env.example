# Postgres
POSTGRES_USER=yt_transcribe
POSTGRES_PASSWORD=changeme
POSTGRES_DB=yt_transcribe
DATABASE_URL=postgresql+psycopg://yt_transcribe:changeme@postgres:5432/yt_transcribe

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# HF model
HF_MODEL_ID=OpenMOSS-Team/MOSS-Transcribe-Diarize

# Set to true only on a machine with an NVIDIA GPU + CUDA + nvidia-container-toolkit.
# Also requires building/running the worker with the GPU compose override, e.g.:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d --build worker
# Falls back to CPU automatically if no CUDA device is found at runtime.
USE_GPU=false

# Frontend / CORS
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
