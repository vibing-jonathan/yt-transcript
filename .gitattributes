# Normalize text files to LF in the repo.
* text=auto eol=lf

# Shell scripts run as Linux container entrypoints — they must be LF
# regardless of the OS the repo is checked out on, or `exec` fails with
# "no such file or directory" (the CR becomes part of the interpreter path).
*.sh text eol=lf
docker-entrypoint-* text eol=lf

# Binary assets — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
